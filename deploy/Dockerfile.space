# Hugging Face Spaces build. Spaces runs the container as uid 1000 and expects
# the app on $PORT (app_port in the Space README front-matter).
FROM python:3.12-slim

RUN useradd -m -u 1000 user
WORKDIR /home/user/app

COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=user app/ ./app/
COPY --chown=user web/ ./web/
COPY --chown=user skills/ ./skills/

USER user

# Writable for uid 1000. Demo memory is per-visitor and expendable, so the
# ephemeral Space filesystem is the right place for it.
ENV MNEMO_DATA_DIR=/home/user/app/data \
    MNEMO_DEMO_MODE=1 \
    MNEMO_DEMO_TURN_LIMIT=25 \
    PORT=8000

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
