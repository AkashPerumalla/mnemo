# ---- Nebius Token Factory (required) ----
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Fast, high-volume calls. Nemotron 3.5 Lightning: 1M context, cheapest tier.
MNEMO_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
# Heavy reasoning, used only when the agent escalates via the think_harder tool.
MNEMO_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# ---- Tavily (optional; enables the web_search tool + Best Use of Tavily prize) ----
TAVILY_API_KEY=

# ---- Local paths ----
MNEMO_DATA_DIR=./data
MNEMO_SKILLS_DIR=./skills
